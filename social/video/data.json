  {
   "id": "title",
   "dur": 6,
   "label": "qwenTPU",
   "captions": [
    [
     0.4,
     5.7,
     "A TPU compiled into the weights of a stock Qwen3.5. No training."
    ]
   ]
  },
  {
   "id": "idea",
   "dur": 10,
   "label": "THE IDEA",
   "captions": [
    [
     0.3,
     4.8,
     "A Gated DeltaNet head is a little RAM with a built-in adder."
    ],
    [
     5,
     9.7,
     "A TPU is mostly RAM and adders. It was sitting there the whole time."
    ]
   ]
  },
  {
   "id": "matvec",
   "dur": 16,
   "label": "LIFE OF A MATVEC",
   "captions": [
    [
     0.3,
     3.7,
     "1. Weights load once, as tokens: one token writes one weight."
    ],
    [
     3.9,
     8.2,
     "2. Activations stream in. Partial sums pile up in place."
    ],
    [
     8.4,
     12.4,
     "3. One multi-hot read returns a whole column sum."
    ],
    [
     12.6,
     15.7,
     "4. The output token is the next layer's input."
    ]
   ]
  },
  {
   "id": "adder",
   "dur": 8,
   "label": "THE ADDER TREE",
   "captions": [
    [
     0.3,
     3.8,
     "Counts are folded top-down, saturating as they go."
    ],
    [
     4,
     7.7,
     "Saturating early is lossless, so 5-bit operands stay exact."
    ]
   ]
  },
  {
   "id": "exact",
   "dur": 10,
   "label": "EXACT EVERYWHERE",
   "captions": [
    [
     0.3,
     4.8,
     "Replayed against NumPy on four machines: zero mismatches."
    ],
    [
     5,
     9.7,
     "The T4 has suites only: 9 of 12 clean, the rest ran out of memory."
    ]
   ]
  },
  {
   "id": "speed",
   "dur": 10,
   "label": "SPEED (A100)",
   "captions": [
